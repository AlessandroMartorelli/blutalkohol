<Window x:Class="Blutalkohol.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Blutalkohol"
        mc:Ignorable="d"
        Title="Blutalkohol" Height="585" Width="350">
    <StackPanel Margin="25,10,25,25"
                Background="WhiteSmoke">
        
        <TextBlock 
            x:Name="txbTitle"
            Text="Blutalkohol V1.1"
            HorizontalAlignment="Center"
            FontSize="20"
            TextWrapping="Wrap">
        </TextBlock>

        <GroupBox
            Header="Geschlecht"
            Width="100"
            Margin="10"
            FontWeight="Bold"
            FontSize="14"
            >
            <StackPanel Margin="10">
                <RadioButton x:Name="rbFrau" Content="Frau" Margin="5"/>
                <RadioButton x:Name="rbMann" Content="Mann" Margin="5" IsChecked="True"/>
                <RadioButton x:Name="rbKind" Content="Kind" Margin="5"/>

            </StackPanel>


        </GroupBox>

        <Label
            Content="Körpergewicht in KG"
            FontSize="14"
            FontWeight="Bold"
            HorizontalAlignment="Center"
         />

        <TextBox
            x:Name="txtGewicht"
            HorizontalAlignment="Center"
            FontSize="14"
            FontWeight="Bold"
            Width="75"
            TextAlignment="Center"
            Background="WhiteSmoke"
            Margin="10,2,10,10"
          
         />

        <Label
            Content="Trinkmenge in Millilieter"
            FontSize="14"
            FontWeight="Bold"
            HorizontalAlignment="Center"
         />

        <TextBox
            x:Name="txtMenge"
            HorizontalAlignment="Center"
            FontSize="14"
            FontWeight="Bold"
            Width="75"
            TextAlignment="Center"
            Background="WhiteSmoke"
            Margin="10,2,10,10"
            
         />

        <Label
             Content="Alkoholgehalt in %"
             FontSize="14"
             FontWeight="Bold"
             HorizontalAlignment="Center"
         />

        <TextBox
            x:Name="txtProzent"
            HorizontalAlignment="Center"
            FontSize="14"
            FontWeight="Bold"
            Width="75"
            TextAlignment="Center"
            Background="WhiteSmoke"
            Margin="10,2,10,10"
    
         />

        <TextBlock
            x:Name="txtBlutwert"
            TextWrapping="Wrap"
            Text="0.0 Promille"
            FontSize="20"
            FontWeight="Heavy"
            Background="WhiteSmoke"
            Padding="10"
            HorizontalAlignment="Center"
            

            
         />

        <Button
            x:Name="btnBerechnen"
            Content="Berechnen"
            FontSize="16"
            FontWeight="Bold"
            Background="SeaShell"
            Margin="60,20,60,0"
            Padding="4"
            Click="btnBerechnen_Click"   
         />



        <Button
            x:Name="btnBeenden"
            Content="Beenden"
            FontSize="16"
            FontWeight="Bold"
            Background="SeaShell"
            Margin="60,20,60,0"
            Padding="4"
            Click="Ende_Click"
               
         />


    </StackPanel>
</Window>
